{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "strict": false,
        "allowJs": true,
        "allowArbitraryExtensions": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "useDefineForClassFields": false,
        "skipLibCheck": true,
        "noEmit": true,
        "paths": {
            "view-entry": ["./src/index.ts"],
            "views/types": ["../shared/types.ts"],
            "views/registry": ["../shared/registry.ts"],
            "views/apis/channel-actions": ["./src/routing/api/channel-actions.ts"],
            "views/apis/channel-invokable": ["./src/routing/api/channel-invokable.ts"],
            "shells/types": ["../shared/types.ts"],
            "shells/boot": ["../shared/runtime/boot.ts"],
            "core/*": ["../shared/runtime/*"],
            "com/*": ["../shared/runtime/*"],
            "shared/*": ["../shared/runtime/*"],
            "cwsp-shared/*": ["../cwsp-shared/src/*"],
            "@fest-lib/cwsp-shared": ["../cwsp-shared/src/index.ts"],
            "@fest-lib/core": ["../../projects/core.ts/src/index.ts"],
            "@fest-lib/dom": ["../../projects/dom.ts/src/index.ts"],
            "@fest-lib/style-lib": ["../../projects/style.ts/src/index.ts"],
            "@fest-lib/fl-ui": ["../../projects/fl.ui/src/index.ts"],
            "@fest-lib/icon": ["../../projects/icon.ts/src/index.ts"],
            "@fest-lib/lure": ["../../projects/lur.e/src/index.ts"],
            "@fest-lib/object": ["../../projects/object.ts/src/index.ts"],
            "@fest-lib/subsystem": ["../../projects/subsystem/src/index.ts"],
            "@fest-lib/uniform": ["../../projects/uniform.ts/src/index.ts"],
            "fl-ui/*": ["../../projects/fl.ui/src/ui/*"]
        }
    }
}
