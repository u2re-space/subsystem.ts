{
    "include": [
        "**/*.ts",
        "**/*.mjs",
        "**/*.js",
        "**/*.d.ts",
        "**/*.tsx",
        "src/**/*.ts",
        "src/**/*.mjs",
        "src/**/*.js",
        "src/**/*.d.ts",
        "src/**/*.tsx",
        "../../modules/projects/**/*.ts",
        "../../modules/projects/**/*.tsx"
    ],
    "exclude": [
        "node_modules/**",
        "dist/**",
        "build/**",
        "coverage/**",
        "logs/**",
        "cache/**",
        "temp/**",
        "tmp/**",
        "temp/**",
        "./src/**/*.js",
        "./src/**/*.jsx"
    ],
    "compilerOptions": {
        "rootDir": "../",
        "skipLibCheck": true,
        "paths": {
            "frontend/shared/*": [
                "./src/frontend/shared/*"
            ],
            "frontend/pwa/*": [
                "./src/frontend/pwa/*"
            ],
            "frontend/shells/*": [
                "./src/frontend/shells/*"
            ],
            "@phosphor-icons/core/assets/*": [
                "./node_modules/@phosphor-icons/core/assets/*"
            ],
            "icons/*": [
                "./node_modules/@phosphor-icons/core/assets/*"
            ],
            "assets/fonts/*": [
                "./assets/fonts/*"
            ],
            "assets/*": [
                "./assets/*"
            ],
            "shells/types": [
                "./shells/types.ts"
            ],
            "views/*": [
                "./views/*"
            ],
            "shells/*": [
                "./shells/*"
            ],
            "@fest-lib/core": [
                "./fest/core/index.ts"
            ],
            "@fest-lib/dom": [
                "./fest/dom/index.ts"
            ],
            "@fest-lib/style-lib": [
                "./fest/style-lib/index.ts"
            ],
            "@fest-lib/fl-ui": [
                "./fest/fl-ui/index.ts"
            ],
            "fl-ui": [
                "../fl.ui/src/ui"
            ],
            "fl-ui/*": [
                "../fl.ui/src/ui/*"
            ],
            "@fest-lib/lure": [
                "./fest/lure/index.ts"
            ],
            "@fest-lib/lure/src/lure/node": [
                "./fest/lure/lure/node"
            ],
            "@fest-lib/lure/src/lure/node/*": [
                "./fest/lure/lure/node/*"
            ],
            "@fest-lib/object": [
                "./fest/object/index.ts"
            ],
            "@fest-lib/object/*": [
                "./fest/object/*"
            ],
            "@fest-lib/uniform": [
                "./fest/uniform/index.ts"
            ],
            "@fest-lib/theme": [
                "./fest/theme/index.ts"
            ],
            "@fest-lib/icon": [
                "./fest/icon/index.ts"
            ],
            "@fest-lib/veela": [
                "./fest/veela/index.ts"
            ],
            "@fest-lib/veela/scss/core": [
                "../veela.css/src/scss/core/index.scss"
            ],
            "@fest-lib/veela/scss": [
                "../veela.css/src/scss/index.scss"
            ],
            "@fest-lib/veela/scss/*": [
                "../veela.css/src/scss/*"
            ],
            "@fest-lib/veela/*": [
                "./fest/veela/*"
            ],
            "com/config/Settings": [
                "./src/other/config/Settings.ts"
            ],
            "com/config/SettingsTypes": [
                "./src/other/config/SettingsTypes.ts"
            ],
            "com/*": [
                "./src/*"
            ],
            "core/*": [
                "./src/*"
            ],
            "shared/*": [
                "./src/*"
            ],
            "@shared/*": [
                "./*"
            ],
            "cwsp-shared/*": [
                "../cwsp-shared/src/*"
            ],
            "@fest-lib/cwsp-shared": [
                "../cwsp-shared/src/index.ts"
            ],
            "@fest-lib/cwsp-shared/*": [
                "../cwsp-shared/src/*"
            ],
            "veela-lib": [
                "./fest/veela/scss/index.scss"
            ],
            "veela-lib/*": [
                "./fest/veela/scss/*"
            ]
        },
        "types": [
            "chrome"
        ],
        "lib": [
            "ESNext",
            "DOM",
            "DOM.Iterable",
            "WebWorker"
        ],
        "jsx": "preserve",
        "jsxImportSource": "@fest-lib/lure/src/lure/node",
        "jsxFactory": "createElement",
        "jsxFragmentFactory": "Fragment",
        "module": "ESNext",
        "target": "ESNext",
        "moduleDetection": "auto",
        "isolatedModules": true,
        "noEmit": true,
        "pretty": true,
        "allowArbitraryExtensions": true,
        "emitDeclarationOnly": true,
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "moduleResolution": "bundler",
        "preserveSymlinks": true,
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "esModuleInterop": true,
        "verbatimModuleSyntax": true,
        "allowJs": true,
        "strict": false,
        "strictNullChecks": false,
        "allowUnusedLabels": true,
        "noImplicitAny": false,
        "noImplicitThis": false,
        "declaration": true,
        "declarationMap": true,
        "inlineSources": true,
        "inlineSourceMap": true,
        "experimentalDecorators": true,
        "noEmitOnError": true,
        "noEmitHelpers": true
    },
    "compileOnSave": false
}
